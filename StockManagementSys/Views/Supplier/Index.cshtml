@using CodeByStudent.Tools
@model IEnumerable<StockManagementSys.Models.Supplier>

@{
    ViewData["Title"] = "Index";
    SortModel sortModel =(SortModel) ViewData["sortModel"];

    PagerModel pager = ViewBag.Pager;
    int intSno = 0;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />


<div class="container-fluid btn-group">

    <div class="col-10">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="col-2 justify-content-end" >
        <p>

            <a asp-action="Create" class="btn btn-success">Create New</a>
        </p>
    </div>
</div>

@* <div class="col-4 p-0 justify-content-end mt-1">
    <form asp-action="index">

        <span class="btn-group">
            <input class="form-control" type="text" name="SearchText" value="@ViewBag.SearchText" placeholder="SearchText" />
            <input class="p-1 m-lg-2 btn btn-sm btn-danger" style="border-radius:10px" type="submit"  value="SearchText"/>

        </span>
    </form>

</div> *@
<div class="row">
    <div class="col-12">
        <partial name="_topBar" model="@pager" />



    </div>


</div>


<table class="table">
    <thead>
        <tr>
            <th>
                Sno
            </th>
            <th>
                <i class="@sortModel.GetColumn("name").SortIcon" arial-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("name").SortExpression"> 
                @Html.DisplayNameFor(model => model.Code)
                </a>
            </th>
            <th>
                <i class="@sortModel.GetColumn("fullname").SortIcon" arial-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("fullname").SortExpression">
                    @Html.DisplayNameFor(model => model.FullName)
                </a>
            <th><a> @Html.DisplayNameFor(model=>model.EmailId)</a></th>
            <th><a> @Html.DisplayNameFor(model => model.Address)</a></th>
            <th><a> @Html.DisplayNameFor(model => model.PhoneNo)</a></th>

            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {

            intSno = intSno + 1;
           
            
            
            <tr>


                <td>
                    @intSno
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmailId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNo)
                </td>
            <td>
            <div class="btn-group">
                <a asp-action="Edit" asp-route-id="@item.Id">
                <span class="btn btn-sm btn-outline-primary">
                    <i class="fa fa-edit" aria-hidden="true"></i>

                </span>
               
                    </a>
            </div>

                <div class="btn-group">
                    <a asp-action="Details" asp-route-id="@item.Id">
                    <span class="btn btn-sm btn-outline-dark">
                        <i class="fa fa-eye" aria-hidden="true"></i>

                    </span>
                    </a>
                </div>

                    <div class="btn-group">
                        <a asp-action="Delete" asp-route-id="@item.Id">
                            <span class="btn btn-sm btn-outline-danger">
                                <i class="fa fa-trash" aria-hidden="true"></i>

                            </span>
                        </a>
                    </div>

            </td>
        </tr>
}
    </tbody>
</table>
