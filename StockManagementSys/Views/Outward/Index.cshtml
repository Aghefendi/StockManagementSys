@model IEnumerable<Outward>

<h2>Mal Çıkış Listesi</h2>

<table class="table">
    <thead>
        <tr>
            <th>Outward ID</th>
            <th>Control Check ID</th>
            <th>Quantity</th>
            <th>Outward Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OutwardId</td>
                <td>@item.ControlCheck.InwardDetail.Product</td>
                <td>@item.Quantity</td>
                <td>@item.OutwardDate</td>
            </tr>
        }
    </tbody>
</table>

<h3>Yeni Mal Çıkışı</h3>

<form method="post" asp-action="ProcessOutward">
    <div class="form-group">
        <label for="controlCheckId">Control Check ID:</label>
        <input type="number" id="controlCheckId" name="controlCheckId" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="quantity">Quantity:</label>
        <input type="number" id="quantity" name="quantity" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Mal Çıkışı Yap</button>
</form>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
