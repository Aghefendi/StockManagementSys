<table class="table">
    <thead>
        <tr>
            <th>
                Sno
            </th>
            
            <th>
                
             
                   Quantity
              
            </th>
            <th> OutwardDate
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {

            intSno = intSno + 1;



            <tr>


                <td>
                    @intSno
                </td>
                <td> @item.Quantity</td>


                <td> @item.OutwardDate.ToString("dd/MM/yyyy")</td>

            </tr>
        }
    </tbody>
</table>
