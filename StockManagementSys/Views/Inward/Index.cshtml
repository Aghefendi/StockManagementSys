@model IEnumerable<Entity.Concreate.Inward>


@{
    ViewData["Title"] = "Index";
    PagerModel pager = ViewBag.Pager;
}

<div class="IndexDıv2">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <div class="container-fluid btn-group text-center ">

        <div class="col-10">
            <h3>- Index</h3>
        </div>
        <div class="col-2 justify-content-end">
            <p>

                <a asp-action="Create" class="btn btn-success">Create New</a>
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <partial name="_topBar" model="@pager" />



        </div>


    </div>

<table class="table text-center">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InwardNumber)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Supplier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InwardDate)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Remarks)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.InwardNumber)
            </td>
          
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.Code)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.InwardDate)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.Remarks)
            </td>
            <td>
                    <div class="btn-group">
                        <a asp-action="Edit" asp-route-id="@item.Id">
                            <span class="btn btn-sm btn-outline-primary">
                                <i class="fa fa-edit" aria-hidden="true"></i>

                            </span>

                        </a>
                    </div>

                    <div class="btn-group">
                        <a asp-action="Details" asp-route-id="@item.Id">
                            <span class="btn btn-sm btn-outline-dark">
                                <i class="fa fa-eye" aria-hidden="true"></i>

                            </span>
                        </a>
                    </div>

                    <div class="btn-group">
                        <a asp-action="Delete" asp-route-id="@item.Id">
                            <span class="btn btn-sm btn-outline-danger">
                                <i class="fa fa-trash" aria-hidden="true"></i>

                            </span>
                        </a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>