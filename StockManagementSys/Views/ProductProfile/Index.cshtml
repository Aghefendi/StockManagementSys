@using CodeByStudent.Tools
@model IEnumerable<StockManagementSys.Models.ProductProfile>

@{
    string currentModel = Helper.GetTypeName(Model.GetType().ToString());

    ViewData["Title"] = currentModel + " - Index";
    SortModel sortModel =(SortModel) ViewData["sortModel"];

    PagerModel pager = ViewBag.Pager;
    int intSno = 0;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<h1>@currentModel - Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

@* <div class="col-4 p-0 justify-content-end mt-1">
    <form asp-action="index">

        <span class="btn-group">
            <input class="form-control" type="text" name="SearchText" value="@ViewBag.SearchText" placeholder="SearchText" />
            <input class="p-1 m-lg-2 btn btn-sm btn-danger" style="border-radius:10px" type="submit"  value="SearchText"/>

        </span>
    </form>

</div> *@
<div class="row">
    <div class="col-12">
        <partial name="_topBar" model="@pager" />



    </div>


</div>


<table class="table">
    <thead>
        <tr>
            <th>
                Sno
            </th>
            <th>
                <i class="@sortModel.GetColumn("name").SortIcon" arial-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("name").SortExpression"> 
                @Html.DisplayNameFor(model => model.Name)
                </a>
            </th>
            <th>
                <i class="@sortModel.GetColumn("description").SortIcon" arial-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("description").SortExpression">
                    @Html.DisplayNameFor(model => model.Description)
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {

            intSno = intSno + 1;
            <tr>
                <td>
                    @intSno
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
