@model StockManagementSys.Models.Product

@{
    string currentModel = Helper.GetTypeName(Model.GetType().ToString());

    ViewData["Title"] = currentModel + " - Edit";
}

<h1>@currentModel - Edit</h1>


<hr />
<div class="col-11 mx-auto pt-0 pt-0">
    <div class="card">
        <div class="card-header bg-success text-uppercase text-white text-center" style="height:40px;">

            <h5>@currentModel -Edit</h5>
        </div>
        <form asp-action="Edit">
            <div class="btn-group">
            <div class="col-8">
                <div class="row">
                    <!-- Control section-->
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group col-6">
                        <label asp-for="Code" class="control-label"></label>
                        <input asp-for="Code" class="form-control" readonly />
                       
                    </div>
                    <div class="form-group col-6">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" readonly />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group col-6">
                        <label asp-for="Description" class="control-label"></label>
                        <input asp-for="Description" class="form-control" readonly />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                 

                    <div class="form-group col-6">
                        <label asp-for="Price" class="control-label"></label>
                        <input asp-for="Price" class="form-control" readonly />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="form-group col-6">
                        <label asp-for="UnitId" class="control-label"></label>
                        <select asp-for="UnitId" class="form-control" asp-items="ViewBag.Units"></select>
                        <span asp-validation-for="UnitId" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group col-6">
                        <label asp-for="CategoryId" class="control-label"></label>
                        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    
                </div>

            </div>


            <div class="col-4 row">
                <div class="form-group col-12 justify-content-center align-middle mb-0 pb-0">
                    <img id="PreviewPhoto" src="~/images/@Model.PhotoUrl" alt="Logo Image"
                         width="300" height="300" style="border:1px;margin-top:30px;" />
                </div>

                <div class="form-group col-2 pt-0 mb-0">
                </div>
                <div class="form-group col-10 pt-0 mt-0">
                    <div class="custom-file">
                        <input asp-for="ProductPhoto" class="custom-file-input" id="customFile"
                               onchange="document.getElementById('PreviewPhoto').src=window.URL.createObjectURL(this.files[0])" />
                        <label class="custom-file-label" for="customFile">Browse Photo</label>

                    </div>
                </div>

            </div>


            </div>


            @*   <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
            </div> *@

            <div class="form-group btn-group col-10">
                <div class="col-1"></div>
                <div class="col-5">
                <input type="submit" value="Update" class="btn btn-primary btn-block" />
                </div>
                <div class="col-5">
                <a class="btn btn-secondary btn-block" asp-action="index"
                   asp-route-pg="@TempData.Peek" ("CurrentPage")>Back</a>
                </div>
                <div class="col-1"></div>

            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
