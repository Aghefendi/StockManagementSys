@model IEnumerable<StockManagementSys.Models.ControlCheck>

@{
    ViewData["Title"] = "Index";
}



<table>
    <thead>
        <tr class="table">
            <th> @Html.DisplayNameFor(model => model.InwardDetail.Product.Name)</th>
            <th> @Html.DisplayNameFor(model => model.InwardDetail.Inward.InwardDate)</th>
            <th> @Html.DisplayNameFor(model => model.InwardDetail.Quantity)</th>
            <th> @Html.DisplayNameFor(model => model.PoDetail.PoHeader.PoDate)</th>
            <th> @Html.DisplayNameFor(model => model.PoDetail.Quantity)</th>
            <th> @Html.DisplayNameFor(model => model.TotalQuantity)</th>
           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="table">
                
                <td>@(item.InwardDetail != null ? item.InwardDetail.Product.Name.ToString() : "N/A")</td>
                <td>@(item.InwardDetail != null ? item.InwardDetail.Inward.InwardDate.ToString() : "N/A")</td>
                <td>@(item.InwardDetail != null ? item.InwardDetail.Quantity.ToString() : "N/A")</td>
                <td>@(item.PoDetail != null ? item.PoDetail.PoHeader.PoDate.ToString() : "N/A")</td>
                <td>@(item.PoDetail != null ? item.PoDetail.Quantity.ToString() : "N/A")</td>
                <th>@item.TotalQuantity</th>
            </tr>
        }
    </tbody>
</table>