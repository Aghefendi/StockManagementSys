@using CodeByStudent.Tools
@model IEnumerable<Entity.Concreate.ControlCheck>

@{
    // string currentModel = Helper.GetTypeName(Model.GetType().ToString());

    ViewData["Title"] = "Index";
    // SortModel sortModel = (SortModel)ViewData["sortModel"];

     PagerModel pager = ViewBag.Pager;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />




<div class="IndexDıv2">

    <h2> Stock Control Page</h2>
    <div class="container-fluid btn-group text-center ">

     
    </div>
<div class="row">
    <div class="col-12">
        <partial name="_topBar" model="@pager" />



    </div>


</div>
<table class="table text-center">
    <thead>
        <tr>
            <th > Product </th>
            
            <th>  InwardDate </th>
            
            
            <th> Quantity</th>
            
           
            <th> Outward </th>

            <th>Outward Date</th>
            
            
            
          
            <th>Total Stock </th>
           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
          

            <tr >
                    <td style="font:bold;"> @item.InwardDetail.Product.Name</td>
                

                <td> @item.InwardDetail.Inward.InwardDate.ToString("dd/MM/yyyy")</td>
             
                <td> @item.InwardDetail.Quantity</td>


                <td> @item.Outward.Quantity.</td>

                    <td> @item.Outward.OutwardDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.TotalStock == 0)
                        {
                            <span class="text-danger">⚠️ 0 </span> <!-- Bu bir uyarı işareti -->
                        }
                        else
                        {
                            @item.TotalStock
                        }
                    </td>
                

              

            </tr>
        }
    </tbody>
</table>
</div>