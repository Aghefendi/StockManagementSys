<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th> Product </th>
            
            <th>  InwardDate </th>
            
            
            <th> Quantity</th>
            
           
            <th> WareHouse Stock </th>
            
            
            
          
            <th>Total Stock </th>
           
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
           @*  <tr class="table">
                
                <td>@(item.InwardDetail != null ? item.InwardDetail.Product.Name.ToString() : "N/A")</td>
                <td>@(item.InwardDetail != null ? item.InwardDetail.Inward.InwardDate.ToString() : "N/A")</td>
                <td>@(item.InwardDetail != null ? item.InwardDetail.Quantity.ToString() : "N/A")</td>
                <td>@(item.PoDetail != null ? item.PoDetail.PoHeader.PoDate.ToString() : "N/A")</td>
                <td>@(item.PoDetail != null ? item.PoDetail.Quantity.ToString() : "N/A")</td>
                <th>@item.TotalQuantity</th>
            </tr> *@

            <tr >
                <td> @item.InwardDetail.Product.Name</td>
                

                <td> @item.InwardDetail.Inward.InwardDate.ToString("dd/MM/yyyy")</td>
             
                <td> @item.InwardDetail.Quantity</td>
                <td> @item.WareHouseStockQuantity.</td>
                <td> @item.TotalStock</td>
                

              

                <div class="btn-group">
                    <a asp-action="Edit" asp-route-id="@item.id">
                        <span class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-edit" aria-hidden="true"></i>

                        </span>

                    </a>
                </div>

                <div class="btn-group">
                    <a asp-action="Details" asp-route-id="@item.id">
                        <span class="btn btn-sm btn-outline-dark">
                            <i class="fa fa-eye" aria-hidden="true"></i>

                        </span>
                    </a>
                </div>

                <div class="btn-group">
                    <a asp-action="Delete" asp-route-id="@item.id">
                        <span class="btn btn-sm btn-outline-danger">
                            <i class="fa fa-trash" aria-hidden="true"></i>

                        </span>
                    </a>
                </div>
            </tr>
        }
    </tbody>
</table>